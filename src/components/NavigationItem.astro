---
import type { NavigationItem } from '../lib/types';

interface Props {
  item: NavigationItem;
  currentPath: string;
  parentMap: Map<string, string>;
}

const { item, currentPath, parentMap } = Astro.props;
const hasChildren = item.children && item.children.length > 0;

function normalize(slug: string): string {
  return slug.startsWith('/') ? slug.slice(1) : slug;
}

const normalizedCurrentPath = normalize(currentPath);
const normalizedItemLink = normalize(item.link || '');
const isActive = normalizedItemLink === normalizedCurrentPath;
const isParentOfCurrentPage = parentMap.get(normalizedCurrentPath) === normalizedItemLink;
const showActive = isActive || isParentOfCurrentPage;
---

<li class={showActive ? 'nav-item active' : 'nav-item'} data-link={item.link}>
  <a
    href={item.link || '#'}
    aria-haspopup={hasChildren ? 'true' : undefined}
    aria-expanded={hasChildren ? 'false' : undefined}
    aria-current={showActive ? 'page' : undefined}
  >
    {item.label}
  </a>
  {
    hasChildren && (
      <ul class="submenu">
        {item.children!.map((child) => (
          <Astro.self item={child} {currentPath} {parentMap} />
        ))}
      </ul>
    )
  }
</li>
